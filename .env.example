# Public port for the secondary application. Change it when 8088 is occupied.
APP_PORT=8088

# Remote PostgreSQL shared with the primary installation. Keep the real value
# only in .env; never commit it or put it in Docker Hub.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# Copy the production-compatible values into the private .env file.
SECRET=
JWT_RESET=
IV=
SECRET_CODE=

# Optional integrations; set only when the secondary installation needs them.
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
IGNORED_CLIENT_IPS=
ICLOCK_ALLOWED_SERIALS=
ICLOCK_FINGERPRINT_VERIFY_MODES=
ICLOCK_CLOCK_SKEW_SECONDS=30
ICLOCK_COMMAND_LEASE_SECONDS=60
ZKTECO_DEVICE_IP=
ZKTECO_DEVICE_PORT=4370
ZKTECO_DEVICE_TIMEOUT_MS=5200
ZKTECO_DEVICE_INPORT=5000
ZKTECO_REALTIME_VERIFY_MODE=
ZKTECO_RECONNECT_DELAY_MS=15000
