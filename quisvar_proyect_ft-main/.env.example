# Debe quedar vacio. En desarrollo Vite y en Docker Nginx reenvian las
# solicitudes al backend local, sin grabar localhost ni una IP en el navegador.
VITE_API_URL=""
VITE_APP_VERSION="local"
VITE_APP_COMMIT_SHA=""

# Actívelo solo cuando el backend y el instalador firmado de Dhyrium Desktop
# estén publicados. La aplicación web seguirá siendo la pantalla principal.
VITE_DHYRIUM_DESKTOP_ENABLED="false"
# URL relativa por defecto. El artefacto se monta en /desktop durante el despliegue.
VITE_DHYRIUM_DESKTOP_DOWNLOAD_URL="/desktop/DhyriumDesktop-0.1.4-win-x64-pilot.zip"

# Optional Playwright overrides.
E2E_APP_URL="http://localhost:8001"
E2E_API_URL="http://localhost:8001/api/v1"
