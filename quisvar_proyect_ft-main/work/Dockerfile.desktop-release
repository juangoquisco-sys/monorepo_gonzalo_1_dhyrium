FROM node:22-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_URL=""
ARG VITE_DHYRIUM_DESKTOP_ENABLED="false"

ENV VITE_API_URL=$VITE_API_URL \
    VITE_DHYRIUM_DESKTOP_ENABLED=$VITE_DHYRIUM_DESKTOP_ENABLED

# The repository's full build currently includes unrelated type errors. The
# release image uses the already-validated Vite production build.
RUN npx vite build

FROM nginx:stable-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
