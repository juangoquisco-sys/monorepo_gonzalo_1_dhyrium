generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id                                                                           Int                               @id @default(autoincrement())
  status                                                                       Boolean                           @default(false)
  password                                                                     String
  email                                                                        String                            @unique
  createdAt                                                                    DateTime                          @default(now())
  updatedAt                                                                    DateTime                          @updatedAt
  cv                                                                           String?
  declaration                                                                  String?
  address                                                                      String?
  ruc                                                                          String?
  withdrawalDeclaration                                                        String?
  roleId                                                                       Int?
  userType                                                                     UserType                          @default(REGULAR)
  contract                                                                     String[]                          @default([])
  isSystemUser                                                                 Boolean                           @default(false)
  createdAttendancePenaltyAdjustments                                          AttendancePenaltyAdjustment[]     @relation("AttendancePenaltyAdjustmentCreator")
  attendancePenaltyAdjustments                                                 AttendancePenaltyAdjustment[]     @relation("AttendancePenaltyAdjustmentUser")
  voidedAttendancePenaltyAdjustments                                           AttendancePenaltyAdjustment[]     @relation("AttendancePenaltyAdjustmentVoider")
  createdAttendanceReconciliations                                             AttendanceReconciliation[]        @relation("AttendanceReconciliationCreator")
  attendanceReconciliations                                                    AttendanceReconciliation[]        @relation("AttendanceReconciliationUser")
  voidedAttendanceReconciliations                                              AttendanceReconciliation[]        @relation("AttendanceReconciliationVoider")
  AuditLog                                                                     AuditLog[]
  uploadedBasicResources                                                       BasicResource[]
  basicTask                                                                    BasicTaskOnUsers[]
  feedbacksBasic                                                               BasicUsersOnFeedbacks[]
  createdCalendarActivities                                                    CalendarActivity[]                @relation("CalendarActivityCreator")
  calendarActivityParticipants                                                 CalendarActivityParticipant[]
  confirmedCommitments                                                         Commitment[]                      @relation("CommitmentConfirmer")
  createdCommitments                                                           Commitment[]                      @relation("CommitmentCreator")
  proposedCommitments                                                          Commitment[]                      @relation("CommitmentProposer")
  commitmentAssignees                                                          CommitmentAssignee[]
  reviewedCommitmentReviews                                                    CommitmentReview[]                @relation("CommitmentReviewReviewer")
  contractDocumentVersions                                                     ContractDocumentVersion[]
  archivedCorporateArchiveDocuments                                            CorporateArchiveDocument[]        @relation("CorporateArchiveDocumentArchiver")
  createdCorporateArchiveDocuments                                             CorporateArchiveDocument[]        @relation("CorporateArchiveDocumentCreator")
  uploadedCorporateArchiveVersions                                             CorporateArchiveDocumentVersion[] @relation("CorporateArchiveVersionUploader")
  archivedCorporateArchiveFolders                                              CorporateArchiveFolder[]          @relation("CorporateArchiveFolderArchiver")
  createdCorporateArchiveFolders                                               CorporateArchiveFolder[]          @relation("CorporateArchiveFolderCreator")
  createdCorporateArchiveRoots                                                 CorporateArchiveRoot[]            @relation("CorporateArchiveRootCreator")
  createdDesktopDocuments                                                      DesktopDocument[]                 @relation("DesktopDocumentCreator")
  DesktopDocument_DesktopDocument_lockedByIdToUsers                            DesktopDocument[]                 @relation("DesktopDocument_lockedByIdToUsers")
  updatedDesktopDocuments                                                      DesktopDocument[]                 @relation("DesktopDocumentUpdater")
  desktopDocumentLaunchTickets                                                 DesktopDocumentLaunchTicket[]     @relation("DesktopDocumentLaunchUser")
  desktopDocumentVersions                                                      DesktopDocumentVersion[]          @relation("DesktopDocumentVersionCreator")
  documentArtifacts                                                            DocumentArtifact[]
  assignedDutyRotations                                                        DutyRotationAssignment[]          @relation("AssignedDutyRotationUser")
  executedDutyRotations                                                        DutyRotationAssignment[]          @relation("ExecutedDutyRotationUser")
  submittedDutyAssignmentEvidence                                              DutyRotationAssignmentEvidence[]  @relation("DutyAssignmentEvidenceSubmitter")
  createdDutyOccurrenceExclusions                                              DutyRotationOccurrenceExclusion[] @relation("DutyOccurrenceExclusionCreator")
  dutyOccurrenceExclusions                                                     DutyRotationOccurrenceExclusion[] @relation("DutyOccurrenceExcludedUser")
  dutyRotationParticipations                                                   DutyRotationParticipant[]
  dutySwapRequests                                                             DutySwapRequest[]                 @relation("DutySwapRequester")
  targetedDutySwaps                                                            DutySwapRequest[]                 @relation("DutySwapTarget")
  equipment                                                                    Equipment?
  expedienteFoliations                                                         ExpedienteFoliation[]
  foliationReprintLogs                                                         FoliationReprintLog[]
  frontendLogEvents                                                            FrontendLogEvent[]
  gateEvents                                                                   GateEvent[]                       @relation("GateEventActor")
  submittedGateEvidence                                                        GateEvidence[]                    @relation("GateEvidenceSubmitter")
  createdGatePasses                                                            GatePass[]                        @relation("GatePassCreator")
  departureMarkedGatePasses                                                    GatePass[]                        @relation("GatePassDepartureMarker")
  returnMarkedGatePasses                                                       GatePass[]                        @relation("GatePassReturnMarker")
  gatePasses                                                                   GatePass[]                        @relation("GatePassUser")
  requestedGateReviewRequests                                                  GateReviewRequest[]               @relation("GateReviewRequester")
  reviewedGateReviewRequests                                                   GateReviewRequest[]               @relation("GateReviewReviewer")
  groups                                                                       GroupOnUsers[]
  iclockCommands                                                               IclockDeviceCommand[]
  LastVisitedStage                                                             LastVisitedStage[]
  LastVisitedTask                                                              LastVisitedTask[]
  Levels                                                                       Levels[]
  createdLicensePenaltyAdjustments                                             LicensePenaltyAdjustment[]        @relation("LicensePenaltyAdjustmentCreator")
  licensePenaltyAdjustments                                                    LicensePenaltyAdjustment[]        @relation("LicensePenaltyAdjustmentUser")
  voidedLicensePenaltyAdjustments                                              LicensePenaltyAdjustment[]        @relation("LicensePenaltyAdjustmentVoider")
  list                                                                         ListOnUsers[]
  message                                                                      Mail[]
  mealOrderOnUsers                                                             MealOrderOnUsers[]
  createdMeetings                                                              Meeting[]                         @relation("MeetingCreator")
  createdMeetingActaRevisions                                                  MeetingActaRevision[]             @relation("MeetingActaRevisionCreator")
  createdMeetingExternalContacts                                               MeetingExternalContact[]          @relation("MeetingExternalContactCreator")
  meetingLifecycleEvents                                                       MeetingLifecycleEvent[]           @relation("MeetingLifecycleActor")
  meetingParticipants                                                          MeetingParticipant[]
  messageReply                                                                 MessageHistory[]
  metradoEvents                                                                MetradoEvent[]                    @relation("MetradoEventActor")
  createdMetradoExports                                                        MetradoExport[]                   @relation("MetradoExportCreator")
  createdMetradoImports                                                        MetradoImport[]                   @relation("MetradoImportCreator")
  createdMetradoProjects                                                       MetradoProject[]                  @relation("MetradoProjectCreator")
  updatedMetradoProjects                                                       MetradoProject[]                  @relation("MetradoProjectUpdater")
  NonTaskActivity_NonTaskActivity_reviewedByIdToUsers                          NonTaskActivity[]                 @relation("NonTaskActivity_reviewedByIdToUsers")
  NonTaskActivity_NonTaskActivity_userIdToUsers                                NonTaskActivity[]                 @relation("NonTaskActivity_userIdToUsers")
  operationalTasks                                                             OperationalTasks[]
  orgMemberships                                                               OrganizationalMembership[]
  paymessage                                                                   PayMail[]
  productionBonusEvents                                                        ProductionBonusEvent[]            @relation("ProductionBonusEventActor")
  productionBonusEvidences                                                     ProductionBonusEvidence[]         @relation("ProductionBonusEvidenceCreator")
  assignedProductionBonuses                                                    ProductionBonusRequest[]          @relation("ProductionBonusAssigner")
  liquidatedProductionBonuses                                                  ProductionBonusRequest[]          @relation("ProductionBonusLiquidator")
  requestedProductionBonuses                                                   ProductionBonusRequest[]          @relation("ProductionBonusRequester")
  supervisedProductionBonuses                                                  ProductionBonusRequest[]          @relation("ProductionBonusSupervisor")
  productionBonusAssignments                                                   ProductionBonusRequest[]          @relation("ProductionBonusUser")
  validatedProductionBonuses                                                   ProductionBonusRequest[]          @relation("ProductionBonusValidator")
  profile                                                                      Profiles?
  createdReports                                                               ProgressReport[]                  @relation("ProgressReportCreator")
  presentedReports                                                             ProgressReport[]                  @relation("ProgressReportPresenter")
  progressReportParticipants                                                   ProgressReportParticipant[]
  project                                                                      Projects[]
  RankingConfig                                                                RankingConfig[]
  RankingEntry                                                                 RankingEntry[]
  RankingOfficeMemberExclusion_RankingOfficeMemberExclusion_createdByIdToUsers RankingOfficeMemberExclusion[]    @relation("RankingOfficeMemberExclusion_createdByIdToUsers")
  RankingOfficeMemberExclusion_RankingOfficeMemberExclusion_userIdToUsers      RankingOfficeMemberExclusion[]    @relation("RankingOfficeMemberExclusion_userIdToUsers")
  RankingPeriod                                                                RankingPeriod[]
  createdReportIndexTemplates                                                  ReportIndexTemplate[]             @relation("ReportIndexTemplateCreator")
  ownedReportIndexTemplates                                                    ReportIndexTemplate[]             @relation("ReportIndexTemplateOwner")
  reports                                                                      Reports[]
  stages                                                                       Stages[]
  SubTaskOnUsers                                                               SubTaskOnUsers[]
  createdTaskDocuments                                                         TaskDocument[]                    @relation("TaskDocumentCreator")
  updatedTaskDocuments                                                         TaskDocument[]                    @relation("TaskDocumentUpdater")
  taskDocumentEditSessions                                                     TaskDocumentEditSession[]         @relation("TaskDocumentEditSessionActor")
  taskDocumentEvents                                                           TaskDocumentEvent[]               @relation("TaskDocumentEventActor")
  taskDocumentFileVersions                                                     TaskDocumentFileVersion[]         @relation("TaskDocumentFileVersionCreator")
  taskDocumentVersions                                                         TaskDocumentVersion[]             @relation("TaskDocumentVersionCreator")
  basicTasks                                                                   TaskOnUsers[]
  payrollInfo                                                                  UserPayrollInfo?
  offices                                                                      UserToOffice[]
  role                                                                         Role?                             @relation(fields: [roleId], references: [id])
  feedbacks                                                                    UsersOnFeedbacks[]
  verificationUser                                                             VerificationUser?
  modBacsicTask                                                                BasicTasks[]                      @relation("BasicTasksToUsers")
  leadOffices                                                                  Division[]                        @relation("OfficeLeaders")
  modTask                                                                      SubTasks[]                        @relation("SubTasksToUsers")
}

model IclockDeviceCommand {
  id             Int                    @id @default(autoincrement())
  serialNumber   String                 @db.VarChar(64)
  userId         Int
  pin            String                 @db.VarChar(9)
  name           String                 @db.VarChar(64)
  operation      IclockCommandOperation @default(UPSERT_USER)
  status         IclockCommandStatus    @default(PENDING)
  attempts       Int                    @default(0)
  leasedAt       DateTime?
  leaseExpiresAt DateTime?
  completedAt    DateTime?
  returnCode     Int?
  result         String?                @db.VarChar(512)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  user           Users                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([serialNumber, status, createdAt])
  @@index([leaseExpiresAt])
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  userId        Int?
  action        String
  referrer      String   @default("")
  responseTime  Int      @default(0)
  statusCode    Int      @default(0)
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  method        String   @default("")
  path          String   @default("")
  severity      String   @default("INFO")
  requestBody   Json     @default("{}")
  queryParams   Json     @default("{}")
  errorResponse Json     @default("{}")
  user          Users?   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([statusCode])
  @@index([method])
  @@index([severity])
  @@index([userId, createdAt])
}

model FrontendLogEvent {
  id             Int      @id @default(autoincrement())
  userId         Int?
  level          String   @default("ERROR")
  type           String
  message        String
  stack          String?
  componentStack String?
  route          String   @default("")
  previousRoute  String   @default("")
  source         String   @default("")
  line           Int?
  column         Int?
  apiMethod      String   @default("")
  apiUrl         String   @default("")
  statusCode     Int?
  requestId      String   @default("")
  sessionId      String   @default("")
  release        String   @default("unknown")
  environment    String   @default("production")
  breadcrumbs    Json     @default("[]")
  context        Json     @default("{}")
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())
  user           Users?   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([type])
  @@index([level])
  @@index([route])
  @@index([statusCode])
  @@index([sessionId])
  @@index([environment])
  @@index([release])
}

model VerificationUser {
  id        Int       @id @default(autoincrement())
  token     String?
  code      String?
  expiresAt DateTime?
  userId    Int       @unique
  user      Users     @relation(fields: [userId], references: [id])
}

model Office {
  id        Int            @id @default(autoincrement())
  name      String
  quantity  Int            @default(0)
  message   Messages[]
  paymesage PayMessages[]
  reports   Reports[]
  users     UserToOffice[]
}

model UserToOffice {
  usersId         Int
  officeId        Int
  isOfficeManager Boolean @default(false)
  office          Office  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  user            Users   @relation(fields: [usersId], references: [id], onDelete: Cascade)

  @@id([usersId, officeId])
}

model WorkStation {
  id          Int         @id @default(autoincrement())
  name        String
  total       Int
  doc         String?
  description String?
  price       String
  equipment   Equipment[]
}

model Equipment {
  id            Int         @id @default(autoincrement())
  name          String
  doc           String?
  description   String?
  userId        Int?        @unique
  workStationId Int
  user          Users?      @relation(fields: [userId], references: [id])
  workStation   WorkStation @relation(fields: [workStationId], references: [id])
}

model GeneralFiles {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  dir         String?
  createdAt   DateTime @default(now())
  description String?
}

model Profiles {
  id           Int      @id @default(autoincrement())
  firstName    String
  lastName     String
  dni          String   @unique @db.VarChar(8)
  phone        String?  @unique
  updatedAt    DateTime @updatedAt
  degree       String   @default("Egresado")
  job          String?
  description  String?
  userId       Int      @unique
  department   String?
  district     String?
  province     String?
  room         String?
  usuario      String?
  addressRef   String?  @default("")
  firstNameRef String   @default("")
  lastNameRef  String   @default("")
  phoneRef     String?  @default("")
  userPc       String?
  gender       Gender   @default(F)
  user         Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPayrollInfo {
  id                String    @id @default(uuid())
  userId            Int       @unique
  contractStartDate DateTime?
  contractEndDate   DateTime?
  monthlySalary     Decimal?  @db.Decimal(12, 2)
  contractType      String    @default("PLANILLA")
  status            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              Users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contractStartDate, contractEndDate])
  @@index([status])
}

model Sector {
  id           Int            @id @default(autoincrement())
  name         String
  specialities Specialities[]
}

model Specialities {
  id               Int                @id @default(autoincrement())
  name             String
  cod              String?
  sectorId         Int?
  createdAt        DateTime           @default(now())
  Sector           Sector?            @relation(fields: [sectorId], references: [id])
  typeSpecialities TypeSpecialities[]
}

model TypeSpecialities {
  id             Int           @id @default(autoincrement())
  name           String
  specialitiesId Int?
  projects       Projects[]
  Specialities   Specialities? @relation(fields: [specialitiesId], references: [id])
}

model Group {
  id         Int            @id @default(autoincrement())
  name       String
  createdAt  DateTime       @default(now())
  active     Boolean        @default(true)
  gNumber    Int?
  divisionId Int?
  division   Division?      @relation(fields: [divisionId], references: [id])
  GroupList  GroupList[]
  groups     GroupOnUsers[]
  stage      Stages[]
}

model OrganizationalUnit {
  id                   String                               @id @default(uuid())
  name                 String
  codemap              String?
  type                 OrganizationalUnitType
  parentId             String?
  isActive             Boolean                              @default(true)
  createdAt            DateTime                             @default(now())
  updatedAt            DateTime                             @updatedAt
  calendarActivities   CalendarActivity[]
  commitments          Commitment[]
  commitmentAssignees  CommitmentAssignee[]
  commitmentContexts   CommitmentContext[]
  meetings             Meeting[]
  projectFocus         OrgUnitProjectFocus[]
  projectStageFocus    OrgUnitProjectStageFocus[]
  memberships          OrganizationalMembership[]
  parent               OrganizationalUnit?                  @relation("OrganizationalUnitTree", fields: [parentId], references: [id])
  children             OrganizationalUnit[]                 @relation("OrganizationalUnitTree")
  legacyMap            OrganizationalUnitLegacyMap?
  meetingViewConfig    OrganizationalUnitMeetingViewConfig?
  payrollOverrides     PayrollPaymessageOrgUnitOverride[]
  progressReports      ProgressReport[]
  reportIndexTemplates ReportIndexTemplate[]

  @@index([parentId])
  @@index([type])
  @@index([isActive])
}

model OrganizationalMembership {
  id                    String                       @id @default(uuid())
  userId                Int
  unitId                String
  role                  OrganizationalMembershipRole
  isPrimary             Boolean                      @default(false)
  startDate             DateTime
  endDate               DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  canManageUnitProjects Boolean                      @default(false)
  isUnitLead            Boolean                      @default(false)
  positionTitle         String?
  unit                  OrganizationalUnit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user                  Users                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([unitId])
  @@index([isUnitLead])
  @@index([canManageUnitProjects])
  @@index([startDate])
  @@index([endDate])
}

model OrganizationalUnitLegacyMap {
  id         String                   @id @default(uuid())
  unitId     String                   @unique
  legacyType OrganizationalLegacyType
  legacyId   Int
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  unit       OrganizationalUnit       @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([legacyType, legacyId])
  @@index([legacyType])
}

model GroupOnUsers {
  userId  Int
  groupId Int
  active  Boolean @default(true)
  mod     Boolean @default(false)
  guest   Boolean @default(false)
  groups  Group   @relation(fields: [groupId], references: [id])
  users   Users   @relation(fields: [userId], references: [id])

  @@id([userId, groupId])
}

model Division {
  id      Int     @id @default(autoincrement())
  name    String
  order   Int?
  groups  Group[]
  leaders Users[] @relation("OfficeLeaders")
}

model GroupList {
  id        Int      @id @default(autoincrement())
  file      String?
  nombre    String?
  createdAt DateTime @default(now())
  groupId   Int
  duty      Duty[]
  groups    Group    @relation(fields: [groupId], references: [id])
}

model Duty {
  id            Int           @id @default(autoincrement())
  listId        Int
  createdAt     DateTime      @default(now())
  CUI           String
  project       String
  dutyGroup     String?
  shortName     String?
  titleMeeting  String?
  dutyGroupDate String?
  groupList     GroupList     @relation(fields: [listId], references: [id], onDelete: Cascade)
  members       DutyMembers[]
}

model DutyMembers {
  id            Int         @id @default(autoincrement())
  position      String?
  fullName      String
  dutyId        Int
  attendance    ListDetails @default(PUNTUAL)
  dailyDuty     String?
  dailyDutyDate String?
  feedBack      String?
  feedBackDate  String?
  duty          Duty        @relation(fields: [dutyId], references: [id], onDelete: Cascade)
  task          DutyTasks[]
}

model DutyTasks {
  id           Int         @id @default(autoincrement())
  name         String?
  percentage   Int?
  dutyMemberId Int
  member       DutyMembers @relation(fields: [dutyMemberId], references: [id], onDelete: Cascade)
}

model OrgUnitProjectFocus {
  id         String                     @id @default(uuid())
  unitId     String
  projectId  Int
  status     OrgUnitProjectFocusStatus  @default(ACTIVE)
  isCurrent  Boolean                    @default(true)
  startDate  DateTime                   @default(now())
  endDate    DateTime?
  notes      String?
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt
  project    Projects                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unit       OrganizationalUnit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  stageFocus OrgUnitProjectStageFocus[]

  @@unique([unitId, projectId])
  @@index([unitId, status])
  @@index([projectId])
  @@index([isCurrent])
}

model OrgUnitProjectStageFocus {
  id             String                    @id @default(uuid())
  unitId         String
  projectId      Int
  stageId        Int
  projectFocusId String?
  status         OrgUnitProjectFocusStatus @default(ACTIVE)
  isCurrent      Boolean                   @default(true)
  startDate      DateTime                  @default(now())
  endDate        DateTime?
  notes          String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  projectFocus   OrgUnitProjectFocus?      @relation(fields: [projectFocusId], references: [id])
  project        Projects                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage          Stages                    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  unit           OrganizationalUnit        @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, stageId])
  @@index([unitId])
  @@index([projectId])
  @@index([stageId])
  @@index([status])
  @@index([isCurrent])
  @@index([projectFocusId])
}

model Meeting {
  id                String                  @id @default(uuid())
  unitId            String
  title             String
  scheduledAt       DateTime                @default(now())
  startedAt         DateTime?
  endedAt           DateTime?
  status            MeetingStatus           @default(DRAFT)
  summary           String?
  createdById       Int
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  defaultView       MeetingWorkspaceView    @default(UNITS)
  scope             MeetingScope            @default(SELF)
  visibleViews      MeetingWorkspaceView[]  @default([UNITS, TECHNICAL_TREE, MEMBERS, PROJECTS_MEMBERS])
  activities        CalendarActivity[]
  commitments       Commitment[]
  commitmentReviews CommitmentReview[]
  createdBy         Users                   @relation("MeetingCreator", fields: [createdById], references: [id])
  unit              OrganizationalUnit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  actaRevisions     MeetingActaRevision[]
  agendaItems       MeetingAgendaItem[]
  lifecycleEvents   MeetingLifecycleEvent[]
  minutes           MeetingMinute[]
  participants      MeetingParticipant[]
  projects          MeetingProject[]
  reports           ProgressReport[]

  @@index([unitId, scheduledAt])
  @@index([status])
  @@index([createdById])
}

model OrganizationalUnitMeetingViewConfig {
  id           String                 @id @default(uuid())
  unitId       String                 @unique
  defaultScope MeetingScope           @default(SELF)
  defaultView  MeetingWorkspaceView   @default(UNITS)
  visibleViews MeetingWorkspaceView[] @default([UNITS, TECHNICAL_TREE, MEMBERS, PROJECTS_MEMBERS])
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  unit         OrganizationalUnit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

model MeetingProject {
  id        String          @id @default(uuid())
  meetingId String
  projectId Int
  topic     String?
  priority  Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  minutes   MeetingMinute[]
  meeting   Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  project   Projects        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([meetingId, projectId])
  @@index([projectId])
}

model MeetingParticipant {
  id                String                   @id @default(uuid())
  meetingId         String
  userId            Int?
  status            MeetingParticipantStatus @default(PRESENT)
  role              String?
  notes             String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  externalContactId String?
  participantType   MeetingParticipantType   @default(USER)
  origin            MeetingParticipantOrigin @default(UNIT_MEMBER)
  displayName       String?
  position          String?
  organization      String?
  externalContact   MeetingExternalContact?  @relation(fields: [externalContactId], references: [id], onDelete: Cascade)
  meeting           Meeting                  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user              Users?                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@unique([meetingId, externalContactId])
  @@index([userId])
  @@index([externalContactId])
  @@index([participantType])
  @@index([origin])
  @@index([status])
}

model MeetingExternalContact {
  id           String               @id @default(uuid())
  name         String
  position     String?
  organization String?
  email        String?
  phone        String?
  document     String?
  notes        String?
  isActive     Boolean              @default(true)
  createdById  Int?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  createdBy    Users?               @relation("MeetingExternalContactCreator", fields: [createdById], references: [id])
  participants MeetingParticipant[]

  @@index([name])
  @@index([organization])
  @@index([document])
  @@index([isActive])
}

model MeetingAgendaItem {
  id           String              @id @default(uuid())
  meetingId    String
  projectId    Int?
  activityId   String?
  commitmentId String?
  title        String
  description  String?
  minutes      String?
  scope        MeetingAgendaScope  @default(GENERAL)
  status       MeetingAgendaStatus @default(OPEN)
  order        Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
