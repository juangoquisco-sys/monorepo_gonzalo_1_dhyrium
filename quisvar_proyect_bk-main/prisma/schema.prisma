  @@unique([documentId, versionNumber])
  @@index([documentId, createdAt])
  @@index([createdById])
}

enum TaskDocumentFileVersionSource {
  ORIGINAL_IMPORT
  WORD_DESKTOP
  RESTORE
}

enum TaskDocumentEditProvider {
  WORD_DESKTOP
}

enum TaskDocumentEditSessionStatus {
  ACTIVE
  SAVED
  RELEASED
  EXPIRED
  CONFLICT
  FAILED
}

enum TaskDocumentEventAction {
  ORIGINAL_IMPORTED
  SESSION_OPENED
  SESSION_HEARTBEAT
  VERSION_SAVED
  VERSION_RESTORED
  SESSION_RELEASED
  SESSION_EXPIRED
  SESSION_CONFLICT
  SESSION_FAILED
}

model TaskDocumentFileVersion {
  id                String                        @id @default(uuid())
  documentId        String
  versionNumber     Int
  sourceFileId      Int?
  sourceBasicFileId Int?
  storageKey        String                        @unique @db.VarChar(500)
  originalName      String                        @db.VarChar(300)
  mimeType          String                        @db.VarChar(150)
  sizeBytes         BigInt
  checksumSha256    String                        @db.VarChar(64)
  source            TaskDocumentFileVersionSource
  createdById       Int
  createdAt         DateTime                      @default(now())
  document          TaskDocument                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy         Users                         @relation("TaskDocumentFileVersionCreator", fields: [createdById], references: [id])
  sourceSessions    TaskDocumentEditSession[]     @relation("TaskDocumentSessionSourceVersion")
  currentSessions   TaskDocumentEditSession[]     @relation("TaskDocumentSessionCurrentVersion")
  events            TaskDocumentEvent[]

  @@unique([documentId, versionNumber])
  @@index([documentId, createdAt])
  @@index([createdById])
  @@index([checksumSha256])
  @@index([sourceFileId])
  @@index([sourceBasicFileId])
}

model TaskDocumentEditSession {
  id                    String                        @id @default(uuid())
  documentId            String
  sourceVersionId       String
  currentVersionId      String
  actorId               Int
  provider              TaskDocumentEditProvider
  status                TaskDocumentEditSessionStatus @default(ACTIVE)
  tokenHash             String                        @unique @db.VarChar(64)
  documentKey           String                        @unique @db.VarChar(128)
  activeLeaseKey        String?                       @unique @db.VarChar(64)
  expectedVersionNumber Int
  expiresAt             DateTime
  lastHeartbeatAt       DateTime                      @default(now())
  closedAt              DateTime?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  document              TaskDocument                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sourceVersion         TaskDocumentFileVersion       @relation("TaskDocumentSessionSourceVersion", fields: [sourceVersionId], references: [id], onDelete: Restrict)
  currentVersion        TaskDocumentFileVersion       @relation("TaskDocumentSessionCurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  actor                 Users                         @relation("TaskDocumentEditSessionActor", fields: [actorId], references: [id])
  events                TaskDocumentEvent[]

  @@index([documentId, status])
  @@index([actorId, status])
  @@index([expiresAt])
}

model TaskDocumentEvent {
  id            String                   @id @default(uuid())
  documentId    String
  fileVersionId String?
  sessionId     String?
  actorId       Int?
  action        TaskDocumentEventAction
  metadata      Json                     @default("{}")
  createdAt     DateTime                 @default(now())
  document      TaskDocument             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fileVersion   TaskDocumentFileVersion? @relation(fields: [fileVersionId], references: [id], onDelete: SetNull)
