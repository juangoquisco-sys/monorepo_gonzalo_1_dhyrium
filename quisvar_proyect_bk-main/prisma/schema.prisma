  @@index([userId])
}

model DutyRotationAssignment {
  id                         String                           @id @default(uuid())
  dutyId                     String
  assignedUserId             Int
  executedByUserId           Int?
  resolutionNotes            String?
  createdAt                  DateTime                         @default(now())
  updatedAt                  DateTime                         @updatedAt
  configurationVersion       Int
  dueOn                      DateTime                         @db.Date
  isLocked                   Boolean                          @default(false)
  occurrenceKey              String
  origin                     DutyRotationAssignmentOrigin     @default(AUTO)
  periodEnd                  DateTime                         @db.Date
  periodStart                DateTime                         @db.Date
  slotKey                    String
  slotLabel                  String
  status                     DutyRotationAssignmentStatus     @default(PENDING)
  baseSlotKey                String?
  completionRequestKey       String?                          @unique
  evidencePolicy             DutyRotationEvidencePolicy       @default(NONE)
  participantUniquenessScope String?
  rosterVersion              Int                              @default(1)
  slotPosition               Int?
