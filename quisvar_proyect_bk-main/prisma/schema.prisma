  duty                       DutyRotation                     @relation(fields: [dutyId], references: [id], onDelete: Cascade)
  executedByUser             Users?                           @relation("ExecutedDutyRotationUser", fields: [executedByUserId], references: [id])
  evidences                  DutyRotationAssignmentEvidence[]
  swapRequests               DutySwapRequest[]

  @@unique([dutyId, occurrenceKey, slotKey])
  @@unique([dutyId, occurrenceKey, assignedUserId, participantUniquenessScope])
  @@index([periodStart, periodEnd])
  @@index([dueOn, status])
  @@index([assignedUserId, periodEnd])
  @@index([status])
}

