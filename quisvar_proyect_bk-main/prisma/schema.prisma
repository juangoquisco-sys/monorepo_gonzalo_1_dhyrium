  updatedAt         DateTime                  @updatedAt
  subTask           SubTasks?                 @relation("SubTaskDocument", fields: [subTaskId], references: [id], onDelete: Cascade)
  basicTask         BasicTasks?               @relation("BasicTaskDocument", fields: [basicTaskId], references: [id], onDelete: Cascade)
  createdBy         Users                     @relation("TaskDocumentCreator", fields: [createdById], references: [id])
  updatedBy         Users                     @relation("TaskDocumentUpdater", fields: [updatedById], references: [id])
