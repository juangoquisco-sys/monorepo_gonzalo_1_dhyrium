  sourceStage   Stages?           @relation("StageVersionSource", fields: [sourceStageId], references: [id], onDelete: SetNull)

  @@unique([groupId, versionNumber])
  @@index([sourceProjectId])
  @@index([sourceStageId])
  @@index([status])
