model StageVersionGroup {
  id        String            @id @default(uuid())
  projectId Int
  baseName  String
  stageType StageVersionType?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  project  Projects       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions StageVersion[]

  @@index([projectId])
  @@index([stageType])
}

model StageVersion {
  id              String                 @id @default(uuid())
  groupId         String
  stageId         Int                    @unique
  versionNumber   Int
  versionLabel    String?
  sourceKind      StageVersionSourceKind
  sourceProjectId Int?
  sourceStageId   Int?
