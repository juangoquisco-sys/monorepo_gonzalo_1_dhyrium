model TaskDocument {
  id                String                    @id @default(uuid())
  subTaskId         Int?                      @unique
  basicTaskId       Int?                      @unique
  title             String                    @default("") @db.VarChar(300)
  contentJson       Json
  contentHtml       String                    @db.Text
  plainText         String                    @db.Text
