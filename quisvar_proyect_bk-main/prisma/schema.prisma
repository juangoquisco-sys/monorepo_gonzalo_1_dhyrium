model Contratc {
  id               Int                   @id @default(autoincrement())
  cui              String                @unique
  name             String
  contractNumber   String                @default("")
  municipality     String                @default("")
  observations     String                @default("")
  projectName      String
  department       String
  province         String
  district         String
  projectShortName String?
  difficulty       Int
  createdAt        DateTime?             @default(now())
  isIndependent    Boolean               @default(false)
  indexContract    String
  details          String?
  type             ContractType          @default(CONTRATO)
  phases           String                @default("[]")
  amount           Float                 @default(0)
  projectId        Int? //@unique
  project          Projects?
  consortiumId     Int?
  companyId        Int?
  consortium       Consortium?           @relation(fields: [consortiumId], references: [id])
  company          Companies?            @relation(fields: [companyId], references: [id])
  specialties      ContractSpecialties[]
  milestones       ContractMilestone[]
  documents        ContractDocument[]
}

model DocumentArtifact {
  id               String                    @id @default(uuid())
  ownerId          Int
  type             DocumentArtifactType
  status           DocumentArtifactStatus    @default(PROCESSING)
  safeName         String
  originalName     String?
  storageKey       String                    @unique
  mimeType         String                    @default("application/pdf")
  sizeBytes        Int
  pageCount        Int
  sha256           String
  manifest         Json?
  idempotencyKey   String?
  failureCode      String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  expiresAt        DateTime?
  owner            Users                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  contractVersions ContractDocumentVersion[]

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, status])
  @@index([expiresAt])
}

model ContractDocument {
  id               String                    @id @default(uuid())
  contractId       Int
  levelCode        String
  levelName        String
  currentVersionId String?                   @unique
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  contract         Contratc                  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  versions         ContractDocumentVersion[] @relation("ContractDocumentVersions")
  currentVersion   ContractDocumentVersion?  @relation("CurrentContractDocumentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@unique([contractId, levelCode])
  @@index([contractId])
}

model ContractDocumentVersion {
  id                 String                    @id @default(uuid())
  contractDocumentId String
  artifactId         String
  versionNumber      Int
  authorId           Int
  previousVersionId  String?
  createdAt          DateTime                  @default(now())
  document           ContractDocument          @relation("ContractDocumentVersions", fields: [contractDocumentId], references: [id], onDelete: Cascade)
  currentFor         ContractDocument?         @relation("CurrentContractDocumentVersion")
  artifact           DocumentArtifact          @relation(fields: [artifactId], references: [id], onDelete: Restrict)
  author             Users                     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  previousVersion    ContractDocumentVersion?  @relation("ContractDocumentVersionHistory", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions       ContractDocumentVersion[] @relation("ContractDocumentVersionHistory")

  @@unique([contractDocumentId, versionNumber])
  @@index([artifactId])
  @@index([authorId])
}

