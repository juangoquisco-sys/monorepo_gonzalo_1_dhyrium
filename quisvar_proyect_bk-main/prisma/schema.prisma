  isCurrent       Boolean                @default(false)
  notes           String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  group         StageVersionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  stage         Stages            @relation("StageVersionStage", fields: [stageId], references: [id], onDelete: Cascade)
