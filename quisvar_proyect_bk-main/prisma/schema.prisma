enum DutyRotationFrequency {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

enum DutyRotationAssignmentStrategy {
  ONE_OWNER_PER_PERIOD
  ONE_OWNER_PER_SLOT
  DISTRIBUTE_PARTICIPANTS
}

enum DutyRotationParticipantSource {
  EXPLICIT
  ACTIVE_ELIGIBLE_SYNC
}

enum DutyRotationEvidencePolicy {
  NONE
  OPTIONAL_PHOTO
  REQUIRED_PHOTO
}

enum DutyRotationWeekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum DutyRotationAssignmentStatus {
  PENDING
  COMPLETED
  NO_SHOW
  OPEN_POOL
}

enum DutyRotationAssignmentOrigin {
  AUTO
  MANUAL
  SWAP
  OPEN_POOL
}

enum DutySwapRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CLAIMED
}

model DutyRotation {
  id                     String                         @id @default(uuid())
  name                   String
  description            String?
  capabilityKey          String?
  accessWindowDays       Int                            @default(14)
  frequency              DutyRotationFrequency
  assignmentStrategy     DutyRotationAssignmentStrategy
  participantSource      DutyRotationParticipantSource  @default(EXPLICIT)
  evidencePolicy         DutyRotationEvidencePolicy     @default(NONE)
  rosterVersion          Int                            @default(1)
  recurrenceRule         Json
  weekStartsOn           DutyRotationWeekday            @default(MONDAY)
  validFrom              DateTime                       @db.Date
  validUntil             DateTime?                      @db.Date
  planningStartsOn       DateTime                       @db.Date
  excludedOccurrenceKeys String[]                       @default([])
  configurationVersion   Int                            @default(1)
  creationKey            String?                        @unique
  lastMutationKey        String?
  isActive               Boolean                        @default(true)
  lastReconciledAt       DateTime?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  participants         DutyRotationParticipant[]
  assignments          DutyRotationAssignment[]
  occurrenceExclusions DutyRotationOccurrenceExclusion[]

  @@index([isActive, validFrom, validUntil])
  @@index([capabilityKey])
}

model DutyRotationParticipant {
  id        String       @id @default(uuid())
  dutyId    String
  duty      DutyRotation @relation(fields: [dutyId], references: [id], onDelete: Cascade)
  userId    Int
  user      Users        @relation(fields: [userId], references: [id])
  position  Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([dutyId, userId])
  @@unique([dutyId, position])
  @@index([userId])
}

model DutyRotationAssignment {
  id                         String                       @id @default(uuid())
  dutyId                     String
  duty                       DutyRotation                 @relation(fields: [dutyId], references: [id], onDelete: Cascade)
  occurrenceKey              String
  periodStart                DateTime                     @db.Date
  periodEnd                  DateTime                     @db.Date
  dueOn                      DateTime                     @db.Date
  slotKey                    String
  slotLabel                  String
  slotInstructions           String?
  baseSlotKey                String?
  slotPosition               Int?
  participantUniquenessScope String?
  assignedUserId             Int
  assignedUser               Users                        @relation("AssignedDutyRotationUser", fields: [assignedUserId], references: [id])
  executedByUserId           Int?
  executedByUser             Users?                       @relation("ExecutedDutyRotationUser", fields: [executedByUserId], references: [id])
  status                     DutyRotationAssignmentStatus @default(PENDING)
  configurationVersion       Int
  rosterVersion              Int                          @default(1)
  evidencePolicy             DutyRotationEvidencePolicy   @default(NONE)
  completionRequestKey       String?                      @unique
  origin                     DutyRotationAssignmentOrigin @default(AUTO)
  isLocked                   Boolean                      @default(false)
  resolutionNotes            String?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt

  swapRequests DutySwapRequest[]
  evidences    DutyRotationAssignmentEvidence[]

  @@unique([dutyId, occurrenceKey, slotKey])
  @@unique([dutyId, occurrenceKey, assignedUserId, participantUniquenessScope])
  @@index([periodStart, periodEnd])
  @@index([dueOn, status])
  @@index([assignedUserId, periodEnd])
  @@index([status])
}

model DutyRotationOccurrenceExclusion {
  id            String       @id @default(uuid())
  dutyId        String
  occurrenceKey String
  userId        Int
  reason        String?
  createdById   Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  duty          DutyRotation @relation(fields: [dutyId], references: [id], onDelete: Cascade)
  user          Users        @relation("DutyOccurrenceExcludedUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy     Users        @relation("DutyOccurrenceExclusionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([dutyId, occurrenceKey, userId])
  @@index([dutyId, occurrenceKey])
  @@index([userId])
}

model DutyRotationAssignmentEvidence {
  id            String                 @id @default(uuid())
  assignmentId  String
  submittedById Int
  storageKey    String                 @unique
  originalName  String
  mimeType      String
  sizeBytes     Int
  createdAt     DateTime               @default(now())
  assignment    DutyRotationAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submittedBy   Users                  @relation("DutyAssignmentEvidenceSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)

  @@index([assignmentId])
  @@index([submittedById])
}

model DutySwapRequest {
  id              String                 @id @default(uuid())
  assignmentId    String
  assignment      DutyRotationAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  requesterUserId Int
  requesterUser   Users                  @relation("DutySwapRequester", fields: [requesterUserId], references: [id])
  targetUserId    Int?
  targetUser      Users?                 @relation("DutySwapTarget", fields: [targetUserId], references: [id])
  status          DutySwapRequestStatus  @default(PENDING)
  reason          String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([assignmentId])
  @@index([requesterUserId])
  @@index([targetUserId])
  @@index([status])
}

model Projects {
  id                  Int                        @id @default(autoincrement())
  name                String?                    @unique
  userId              Int?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  typeSpecialityId    Int
  typeSpeciality      TypeSpecialities           @relation(fields: [typeSpecialityId], references: [id])
  moderator           Users?                     @relation(fields: [userId], references: [id])
  contractId          Int                        @unique
  contract            Contratc                   @relation(fields: [contractId], references: [id])
  stages              Stages[]
  projectFocus        OrgUnitProjectFocus[]
  projectStageFocus   OrgUnitProjectStageFocus[]
  stageVersionGroups  StageVersionGroup[]
  stageVersionSources StageVersion[]             @relation("StageVersionSourceProject")
  meetingProjects     MeetingProject[]
  agendaItems         MeetingAgendaItem[]
  calendarActivities  CalendarActivity[]
  progressReports     ProgressReport[]
  commitments         Commitment[]
  metrados            MetradoProject[]
  commitmentContexts  CommitmentContext[]
  basicResources      BasicResource[]
}

model Stages {
  id                  Int                        @id @default(autoincrement())
  name                String
  //-----------------------------------------------------
  startDate           DateTime                   @default(now())
  untilDate           DateTime                   @default(now())
  status              Boolean                    @default(false)
  isProject           Boolean                    @default(false)
  moderatorId         Int?
  rootTypeItem        TypeItem                   @default(NUM)
  //-----------------------------------------------------
  // company          Company?          @relation(fields: [companyId], references: [id])
  // consortium       Consortium?       @relation(fields: [consortiumId], references: [id])
  // specialists      PersonBussiness[]
  moderator           Users?                     @relation(fields: [moderatorId], references: [id])
  //-----------------------------------------------------
  bachelorCost        Float                      @default(0)
  professionalCost    Float                      @default(0)
  graduateCost        Float                      @default(0)
  internCost          Float                      @default(0)
  monthlyPrice        Float                      @default(0)
  stayPrice           Float                      @default(1000)
  budget              Float                      @default(0)
  groupId             Int?
  group               Group?                     @relation(fields: [groupId], references: [id])
  //-----------------------------------------------------
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  project             Projects                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId           Int
  levels              Levels[]
  basics              BasicLevels[]
  commitmentContexts  CommitmentContext[]
  basicResources      BasicResource[]
  projectStageFocus   OrgUnitProjectStageFocus[]
  versionMetadata     StageVersion?              @relation("StageVersionStage")
  sourceStageVersions StageVersion[]             @relation("StageVersionSource")
  // companyId        Int?
  // consortiumId     Int?
