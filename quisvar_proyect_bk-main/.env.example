NODE_ENV="development"

# Canonical DOCX editing with Microsoft Word. HTTPS is mandatory outside an
# explicitly enabled development workstation.
TASK_DOCUMENT_EXTERNAL_BASE_URL="https://dev.example.test/api/v1"
TASK_DOCUMENT_SESSION_TTL_MINUTES="60"
TASK_DOCUMENT_SESSION_MAX_TTL_MINUTES="480"
TASK_DOCUMENT_LOCK_TTL_MINUTES="10"
TASK_DOCUMENT_ALLOW_INSECURE_HTTP="false"

PORT="8081"
HOST="localhost"
ROUTE="api/v1"

SECRET="change-me-local-jwt-secret"
JWT_RESET="change-me-local-reset-secret"
# AES-192-CBC requires a 16-byte IV represented as 32 hexadecimal characters.
IV="0123456789abcdef0123456789abcdef"
SECRET_CODE="change-me-local-secret-code"

# Configure this manually for each developer environment.
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# Optional local network settings.
IGNORED_CLIENT_IPS=""

# ZKTeco ADMS PUSH. Keep both lists empty until the real device serial and
# fingerprint verifyMode have been confirmed; empty values fail closed.
ICLOCK_ALLOWED_SERIALS=""
ICLOCK_FINGERPRINT_VERIFY_MODES=""
ICLOCK_CLOCK_SKEW_SECONDS="30"
ICLOCK_COMMAND_LEASE_SECONDS="60"

# Optional direct connection through zkteco-js. Leave the IP empty to keep it
# disabled. The real-time mode must be confirmed on the physical device and
# included in ICLOCK_FINGERPRINT_VERIFY_MODES.
ZKTECO_DEVICE_IP=""
ZKTECO_DEVICE_PORT="4370"
ZKTECO_DEVICE_TIMEOUT_MS="5200"
ZKTECO_DEVICE_INPORT="5000"
ZKTECO_REALTIME_VERIFY_MODE=""
ZKTECO_RECONNECT_DELAY_MS="15000"

# Gmail SMTP credentials. Use an application password, never the account password.
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM=""
